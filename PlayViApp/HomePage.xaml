<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlayViApp.HomePage"
             BackgroundColor="#141414">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label x:Name="WelcomeLabel" TextColor="White" FontSize="22"
                   FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Switch Profile" Clicked="OnSwitchProfileClicked"
                    BackgroundColor="Transparent" BorderColor="Gray" BorderWidth="1" TextColor="White" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <SearchBar x:Name="SearchBox" Placeholder="Search titles..."
                       SearchButtonPressed="OnSearchPressed" TextChanged="OnSearchTextChanged"
                       TextColor="White" PlaceholderColor="Gray" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Picker x:Name="GenrePicker" Grid.Column="0" Title="Genre"
                        TextColor="White" TitleColor="Gray" SelectedIndexChanged="OnFilterChanged" />
                <Picker x:Name="EraPicker" Grid.Column="1" Title="Era"
                        TextColor="White" TitleColor="Gray" SelectedIndexChanged="OnFilterChanged" />
                <Picker x:Name="TypePicker" Grid.Column="2" Title="Type"
                        TextColor="White" TitleColor="Gray" SelectedIndexChanged="OnFilterChanged" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView x:Name="TitlesView" Grid.Row="2"
                        SelectionMode="Single" SelectionChanged="OnTitleSelected">
            <CollectionView.EmptyView>
                <Label Text="No titles found." TextColor="Gray"
                       HorizontalOptions="Center" Margin="0,40,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1F1F1F" StrokeThickness="0"
                            StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="70,*" ColumnSpacing="14">
                            <Border BackgroundColor="#7C4DFF" WidthRequest="70" HeightRequest="100"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                <Label Text="{Binding Initial}" FontSize="32" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Subtitle}" TextColor="#B3B3B3" FontSize="13" />
                                <Label Text="{Binding Description}" TextColor="Gray" FontSize="13"
                                       MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>