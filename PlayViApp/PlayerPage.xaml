<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PlayViApp.PlayerPage"
             BackgroundColor="Black">

    <Grid>

        <!-- Vídeo ocupando toda a tela, sem os controles padrão -->
        <toolkit:MediaElement x:Name="Player"
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="False"
                              Aspect="AspectFit"
                              MediaOpened="OnMediaOpened"
                              MediaEnded="OnMediaEnded"
                              MediaFailed="OnMediaFailed"
                              StateChanged="OnStateChanged"
                              PositionChanged="OnPositionChanged" />

        <!-- Camada invisível que captura o toque para mostrar/esconder os controles -->
        <BoxView Color="#01000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScreenTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <ActivityIndicator x:Name="Spinner" IsRunning="True" Color="#7C4DFF"
                           WidthRequest="48" HeightRequest="48"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           InputTransparent="True" />

        <Label x:Name="ErrorLabel" IsVisible="False" TextColor="White" FontSize="18"
               HorizontalOptions="Center" VerticalOptions="Center"
               HorizontalTextAlignment="Center" InputTransparent="True" />

        <!-- Controles (o Grid deixa o toque passar; só os filhos recebem clique) -->
        <Grid x:Name="Controls" RowDefinitions="Auto,*,Auto"
              InputTransparent="True" CascadeInputTransparent="False">

            <!-- Topo -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,12">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Button Text="←  Voltar" Clicked="OnBackClicked"
                        BackgroundColor="#66000000" TextColor="White" />
                <Label x:Name="TitleLabel" Grid.Column="1" TextColor="White"
                       FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <!-- Centro -->
            <HorizontalStackLayout Grid.Row="1" Spacing="28"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="«  10s" Clicked="OnSkipBackClicked"
                        BackgroundColor="#66000000" TextColor="White" />
                <Button x:Name="PlayPauseButton" Text="❚❚" Clicked="OnPlayPauseClicked"
                        WidthRequest="72" HeightRequest="72" CornerRadius="36" FontSize="24"
                        BackgroundColor="#7C4DFF" TextColor="White" />
                <Button Text="10s  »" Clicked="OnSkipForwardClicked"
                        BackgroundColor="#66000000" TextColor="White" />
            </HorizontalStackLayout>

            <!-- Base: tempo + barra de progresso na largura total -->
            <VerticalStackLayout Grid.Row="2" Spacing="0" Padding="0,0,0,6">
                <VerticalStackLayout.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#CC000000" Offset="1.0" />
                    </LinearGradientBrush>
                </VerticalStackLayout.Background>

                <Grid ColumnDefinitions="*,Auto" Padding="20,16,20,0">
                    <Label x:Name="TimeLabel" Text="00:00" TextColor="White" FontSize="14" />
                    <Label x:Name="DurationLabel" Grid.Column="1" Text="00:00"
                           TextColor="#B3B3B3" FontSize="14" />
                </Grid>

                <Slider x:Name="ProgressSlider"
                        Minimum="0" Maximum="1" Value="0"
                        HorizontalOptions="Fill" Margin="0"
                        MinimumTrackColor="#7C4DFF"
                        MaximumTrackColor="#66FFFFFF"
                        ThumbColor="#7C4DFF"
                        DragStarted="OnDragStarted"
                        DragCompleted="OnDragCompleted"
                        ValueChanged="OnSliderValueChanged" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>