<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PlayViApp.PlayerPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12" BackgroundColor="#141414">
            <Button Text="← Back" Clicked="OnBackClicked"
                    BackgroundColor="Transparent" TextColor="White" />
            <Label x:Name="TitleLabel" Grid.Column="1" TextColor="White" FontSize="18"
                   FontAttributes="Bold" VerticalOptions="Center" Margin="12,0,0,0" />
        </Grid>

        <toolkit:MediaElement x:Name="Player" Grid.Row="1"
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="True"
                              Aspect="AspectFit" />
    </Grid>
</ContentPage>