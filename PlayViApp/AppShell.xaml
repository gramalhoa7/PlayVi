<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PlayViApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:PlayViApp"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False">

    <ShellContent Route="login" ContentTemplate="{DataTemplate local:MainPage}" />
    <ShellContent Route="profiles" ContentTemplate="{DataTemplate local:ProfilesPage}" />
    <ShellContent Route="home" ContentTemplate="{DataTemplate local:HomePage}" />

</Shell>